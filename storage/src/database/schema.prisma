generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model Image {
  id        String         @id @default(uuid())
  filename  String
  mimeType  String         @map("mime_type")
  size      Int
  width     Int
  height    Int
  createdAt DateTime       @default(now()) @map("created_at")
  variants  ImageVariant[]

  @@map("images")
}

enum ImageVariantKind {
  THUMBNAIL
  MEDIUM
  LARGE
}

model ImageVariant {
  id        String           @id @default(uuid())
  imageId   String           @map("image_id")
  image     Image            @relation(fields: [imageId], references: [id], onDelete: Cascade)
  kind      ImageVariantKind
  mimeType  String           @map("mime_type")
  size      Int
  width     Int
  height    Int
  createdAt DateTime         @default(now()) @map("created_at")

  @@unique([imageId, kind])
  @@index([imageId])
  @@map("image_variants")
}

model File {
  id           String   @id @default(uuid())
  resourceId   String   @unique @map("resource_id")
  resource     Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  filename     String
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  size         Int
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("files")
}

model Folder {
  id         String   @id @default(uuid())
  resourceId String   @unique @map("resource_id")
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("folders")
}

model Resource {
  id           String        @id @default(uuid())
  slug         String
  parentId     String?       @map("parent_id")
  parent       Resource?     @relation("ResourceChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children     Resource[]    @relation("ResourceChildren")
  file         File?
  folder       Folder?
  accessTokens AccessToken[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@unique([parentId, slug])
  @@index([parentId])
  @@map("resources")
}

model AccessToken {
  id        String   @id @default(uuid())
  token     String   @unique
  folderId  String   @map("folder_id")
  folder    Resource @relation(fields: [folderId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([folderId])
  @@map("access_tokens")
}
