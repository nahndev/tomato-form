generator client {
  provider = "prisma-client"
  output   = "./generated"
}


datasource db {
  provider = "postgresql"
}

model Board {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  templates   Template[]   @relation("BoardTemplates")
  jobs        Job[]
  actions     Action[]
  submissions Submission[]

  @@map("boards")
}

model Template {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  boards  Board[]  @relation("BoardTemplates")
  actions Action[]

  templateVersions TemplateVersion[]

  @@map("templates")
}

model TemplateVersion {
  id         String   @id @default(uuid())
  templateId String   @map("template_id")
  /** Semantic version string (e.g. "1.0.0"), managed via the `semver` library. */
  version    String
  /**
   * Frozen copy of the yjs doc at publish time - `widgets`, `layouts`,
   * `widgetToSession`, `properties`, `sessions`, and whatever gets added later
   * (e.g. `sessionProperties`) - as one schemaless blob, so new record kinds
   * don't need a migration.
   */
  snapshot   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  template    Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@unique([templateId, version])
  @@index([templateId])
  @@map("template_versions")
}

model Submission {
  id                String   @id @default(uuid())
  boardId           String   @map("board_id")
  templateVersionId String   @map("template_version_id")
  data              Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  board           Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  templateVersion TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)

  @@index([boardId])
  @@index([templateVersionId])
  @@map("submissions")
}

model User {
  uuid      String   @id @default(uuid())
  name      String
  email     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Job {
  id         String   @id @default(uuid())
  boardId    String   @map("board_id")
  name       String
  expression String
  enable     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  board      Board          @relation(fields: [boardId], references: [id], onDelete: Cascade)
  actions    Action[]
  executions JobExecution[]

  @@index([boardId])
  @@map("jobs")
}

enum ActionType {
  SUBMISSION_CREATION
  SEND_MAIL
}

model Action {
  id    String     @id @default(uuid())
  jobId String     @map("job_id")
  type  ActionType
  order Int

  // Hoisted, FK-backed — only set when type = SUBMISSION_CREATION
  templateId String? @map("template_id")
  boardId    String? @map("board_id")

  // Remaining type-specific data: SEND_MAIL -> { recipients, content }
  payload Json @default("{}")

  job      Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  template Template? @relation(fields: [templateId], references: [id], onDelete: Restrict)
  board    Board?    @relation(fields: [boardId], references: [id], onDelete: Restrict)

  @@unique([jobId, order])
  @@index([jobId])
  @@map("actions")
}

enum JobExecutionStatus {
  running
  success
  failed
}

model JobExecution {
  id         String             @id @default(uuid())
  jobId      String             @map("job_id")
  status     JobExecutionStatus
  startedAt  DateTime           @map("started_at")
  finishedAt DateTime?          @map("finished_at")
  error      String?
  result     Json?

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, startedAt])
  @@map("job_executions")
}

model Cron {
  id         String   @id @default(uuid())
  key        String   @unique
  expression String
  event      Json
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("cron_registrations")
}
