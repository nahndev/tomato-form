generator client {
  provider = "prisma-client"
  output   = "./generated"
}


datasource db {
  provider = "postgresql"
}

model Board {
  id        String   @id @default(uuid())
  name      String
  columns   Json     @default("[]")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  templates   Template[]   @relation("BoardTemplates")
  submissions Submission[]

  @@map("boards")
}

model Template {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  boards Board[] @relation("BoardTemplates")

  templateVersions TemplateVersion[]

  @@map("templates")
}

model TemplateVersion {
  id         String   @id @default(uuid())
  templateId String   @map("template_id")
  /** Semantic version string (e.g. "1.0.0"), managed via the `semver` library. */
  version    String
  /**
   * Frozen copy of the yjs doc at publish time - `widgets`, `layouts`,
   * `widgetToSession`, `sessions`, and whatever gets added later - as one
   * schemaless blob, so new record kinds don't need a migration.
   */
  snapshot   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  template    Template     @relation(fields: [templateId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@unique([templateId, version])
  @@index([templateId])
  @@map("template_versions")
}

model Submission {
  id                String   @id @default(uuid())
  boardId           String   @map("board_id")
  templateVersionId String   @map("template_version_id")
  data              Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  board           Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  templateVersion TemplateVersion @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)

  @@index([boardId])
  @@index([templateVersionId])
  @@map("submissions")
}

model User {
  uuid      String   @id @default(uuid())
  name      String
  email     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

